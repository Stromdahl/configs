                  "type": "vacuum-commands",
                  "commands": [
                    "start_pause",
                    "return_home",
                    "locate"
                  ]
                }
              ],
              "features_position": "bottom",
              "card_mod": {
                "style": "ha-card {\n  background: linear-gradient(135deg, #D7B26D 0%, #c79a4a 100%) !important;\n  --primary-text-color: #1A1208;\n  --secondary-text-color: rgba(26,18,8,0.7);\n  --tile-color: rgba(0,0,0,0.15);\n  border: 0;\n  border-radius: 22px;\n  padding: 12px;\n}\nha-card .name {\n  font-size: 18px !important;\n  font-weight: 800 !important;\n}\nha-tile-icon {\n  --tile-color: rgba(0,0,0,0.15);\n}"
              },
              "grid_options": {
                "columns": 12,
                "rows": 2
              }
