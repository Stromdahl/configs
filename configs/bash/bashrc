# ~/.bashrc

# =============================================================================
# - ENVIRONMENT SETUP
# =============================================================================

# Preferred editor
export EDITOR=nvim

# Default file permissions
umask 022

# Add custom local bin to PATH
export PATH="$HOME/.local/bin:$PATH"

# man options (must be exported)
export MANOPT="--nh --nj"

# less must allow ANSI escapes for termcap coloring
export LESS='-R'
export MANPAGER='less -R'
export PAGER='less -R'

# termcap styling for man -> less
export LESS_TERMCAP_mb=$'\e[1;32m'
export LESS_TERMCAP_md=$'\e[1;32m'
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_so=$'\e[01;33m'
export LESS_TERMCAP_ue=$'\e[0m'
export LESS_TERMCAP_us=$'\e[1;4;31m'

# Enable color support for `ls` and other commands
if [ -x /usr/bin/dircolors ]; then
    eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# =============================================================================
# - SHELL OPTIONS
# =============================================================================

# Make bash append to the history file instead of overwriting it
shopt -s histappend

# Check window size after each command and update LINES and COLUMNS
shopt -s checkwinsize

# Extended globbing
shopt -s extglob

# Case-insensitive globbing
shopt -s nocaseglob

# Enable command autocorrection (mild)
shopt -s dirspell cdspell


# =============================================================================
# - HISTORY BEHAVIOR
# =============================================================================

export HISTSIZE= #keep forever
export HISTFILESIZE= #keep forever
export HISTCONTROL=ignoredups:erasedups
export HISTIGNORE="ls:cd:pwd:exit:clear"

# =============================================================================
# - PROMPT (PS1) CONFIGURATION
# =============================================================================

# Load bash-completion (provides ssh, docker, systemctl, etc.)
[ -r /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion

# Colors — defined once
_C_RED="\[\033[91m\]"
_C_CYAN="\[\033[96m\]"
_C_BLUE="\[\033[94m\]"
_C_YELLOW="\[\033[93m\]"
_C_GRAY="\[\033[37m\]"
_C_RST="\[\033[0m\]"

__prompt_command() {
  local exit_code=$?

  # Terminal title
  printf '\033]0;%s@%s: %s\007' "$USER" "$HOSTNAME" "${PWD/$HOME/~}"
  # foot OSC 7 (open new terminal in same dir with ctrl+shift+n)
  printf '\033]7;file://%s%s\033\\' "$HOSTNAME" "$PWD"

  local status=""
  [ $exit_code -ne 0 ] && status="${_C_RED}[$exit_code] "

  # Show \u@\h only when in an SSH session — local prompts stay terse.
  local host_part=""
  [ -n "${SSH_CONNECTION:-}" ] && host_part="\u@\h "

  PS1="${status}${_C_CYAN}${host_part}\#$(__git_ps1 " ${_C_YELLOW}(%s)") ${_C_BLUE}\w\n${_C_GRAY}\$${_C_RST} "
}

PROMPT_DIRTRIM=3
export PROMPT_COMMAND="__prompt_command"

# =============================================================================
# - CUSTOM FUNCTIONS
# =============================================================================

# Create directory and enter it
function mkcd () {
    mkdir -p "$1" && cd "$1"
}

# Search running processes
function psearch () {
    ps aux | grep -i "$1" | grep -v grep
}


# Dump the clipboard into a temp file and print its path.
# Mirrors the `xco` alias from the wl-clipboard / xclip snippets, but has to
# pick the tool itself — aliases don't expand inside a function body.
function xcotemp () {
    local f
    f=$(mktemp --tmpdir clipboard-XXXXXX.txt) || return 1
    if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste >/dev/null 2>&1; then
        wl-paste --no-newline > "$f"
    elif command -v xclip >/dev/null 2>&1; then
        xclip -out -selection clipboard > "$f"
    else
        echo "xcotemp: neither wl-paste nor xclip available" >&2
        command rm -f "$f"
        return 1
    fi
    echo "$f"
}

function generate_password() {
	local l=$1
       	[ "$l" == "" ] && l=32
      	tr -dc A-Za-z0-9_ < /dev/urandom | head -c ${l} | xargs
}

# Persistent ssh-agent shared across every shell via a stable socket path.
# Only spawn a new agent when the existing one is genuinely unreachable
# (ssh-add -l exit 2). A live agent — even an empty one still awaiting its
# passphrase (exit 1) — is reused, so an already-unlocked key is never lost
# and background/non-interactive shells can't clobber the interactive one.
export SSH_AUTH_SOCK=~/.ssh/ssh_auth_sock
ssh-add -l >/dev/null 2>&1
if [ $? -eq 2 ]; then
  eval "$(ssh-agent -s)" >/dev/null 2>&1
  ln -sf "$SSH_AUTH_SOCK" ~/.ssh/ssh_auth_sock
  export SSH_AUTH_SOCK=~/.ssh/ssh_auth_sock
fi

# =============================================================================
# - ALIASES
# =============================================================================

alias la='ll -A'
alias ll='ls -hltF --time-style=long-iso --group-directories-first'
alias reload='source ~/.bashrc'
alias update='sudo apt update && sudo apt upgrade -y'
alias vim=nvim
alias fd=fdfind

# Safer operations
alias cp='cp -vi'
alias mv='mv -vi'
alias rm='rm -vi'

# Calendar
alias ncal='ncal -w -3 -M'
alias week='date +%V'

# Quality of life
alias pubkey='cat $HOME/.ssh/pubkey';
alias ebrc="vim ~/.bashrc";

# Work journal
alias daily="mkdir -p ~/notes && cd ~/notes && $EDITOR ~/notes/daily.md"

# Source all files in ~/.bashrc.d
if [ -d "$HOME/.bashrc.d" ]; then
  for f in "$HOME/.bashrc.d/"*.sh; do
    [ -r "$f" ] && . "$f"
  done
fi
