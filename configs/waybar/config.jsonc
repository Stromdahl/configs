{
	"layer": "bottom",
	"position": "bottom",
	"spacing": 0,

	"modules-left": ["sway/workspaces", "sway/mode"],
	"modules-center": ["clock"],
	"modules-right": [
		"idle_inhibitor",
		"bluetooth",
		"cpu",
		"temperature",
		"memory",
		"disk",
		"pulseaudio",
		"custom/bandwidth",
		"network#wifi",
		"network#ethernet",
		"battery",
		"sway/language"
	],

	"clock": {
		"format": "{:%Y-%m-%d  %H:%M}",
		"tooltip-format": "<tt>{calendar}</tt>",
		"locale": "en_GB.UTF-8",
		"calendar": {
			"mode": "month",
			"on-scroll": 1,
			"weeks-pos": "left",
			"format": {
				"today": "<span color='#fe8019'><b>{}</b></span>",
				"weeks": "<span color='#a89984'>{:%V}</span>"
			}
		}
	},

	"idle_inhibitor": {
		"format": "{icon}",
		"format-icons": {
			"activated": "󰅶",
			"deactivated": "󰾪"
		},
		"tooltip-format-activated": "idle inhibitor on",
		"tooltip-format-deactivated": "idle inhibitor off"
	},

	"bluetooth": {
		"format": "󰂯",
		"format-connected": "󰂱 {device_alias}",
		"format-off": "",
		"tooltip-format": "{status}",
		"tooltip-format-connected": "{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}",
		"on-click": "blueman-manager"
	},

	"cpu": {
		"format": "󰻠 {usage}%",
		"interval": 2,
		"states": {
			"warning": 70,
			"critical": 90
		}
	},

	"temperature": {
		"format": "󰔏 {temperatureC}°C",
		"critical-threshold": 80,
		"format-critical": "󰔏 {temperatureC}°C"
	},

	"memory": {
		"format": "󰍛 {avail:0.1f}G free",
		"tooltip-format": "{used:0.1f}G used / {total:0.1f}G total",
		"states": {
			"warning": 70,
			"critical": 90
		}
	},

	"disk": {
		"format": "󰋊 {free} free",
		"tooltip-format": "{used} used / {total} total",
		"path": "/"
	},

	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-muted": "󰖁 muted",
		"format-icons": {
			"default": ["󰕿", "󰖀", "󰕾"]
		},
		"on-click": "pavucontrol"
	},

	"custom/bandwidth": {
		"exec": "~/.dotfiles/configs/waybar/scripts/bandwidth",
		"interval": 4,
		"format": "{}"
	},

	"network#wifi": {
		"interface": "wl*",
		"format": "󰤨 {ipaddr}",
		"format-disconnected": "",
		"tooltip-format": "{essid} {signalStrength}%"
	},

	"network#ethernet": {
		"interface": "en*",
		"format": "󰈀 {ipaddr}",
		"format-disconnected": "",
		"tooltip-format": "{ifname}"
	},

	"battery": {
		"format": "{icon} {capacity}%",
		"format-charging": "󰂄 {capacity}%",
		"format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂"],
		"states": {
			"warning": 30,
			"critical": 15
		},
		"tooltip-format": "{timeTo}"
	},

	"sway/language": {
		"format": "󰌌 {short}"
	}
}
