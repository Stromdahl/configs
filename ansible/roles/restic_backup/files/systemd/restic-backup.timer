[Unit]
Description=Daily restic backup of the SSD appdata subvolume

[Timer]
# 02:00 — before SnapRAID's nightly sync (03:00) and well off the SnapRAID
# scrub (Sun 04:00) / btrfs scrub (1st of month 05:00) windows, so the new
# backup snapshot lands on the HDD pool before parity is computed over it and
# no two maintenance jobs touch a pool at the same time.
OnCalendar=*-*-* 02:00:00
Persistent=true

[Install]
WantedBy=timers.target
