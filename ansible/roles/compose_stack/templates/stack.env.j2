# Rendered by Ansible from roles/compose_stack/templates/stack.env.j2.
# Mode 0600 — contains secrets. Do NOT commit this file on helium.
# Jinja vars resolved at render time; compose ${VAR} syntax left intact in
# docker-compose.yml.j2 and resolved by docker compose at run time from here.

DOMAIN={{ compose_domain }}
ACME_EMAIL={{ compose_acme_email }}
CF_DNS_API_TOKEN={{ cloudflare_dns_api_token }}
TRAEFIK_DASHBOARD_AUTH={{ traefik_dashboard_auth | replace('$', '$$') }}
UID={{ jellyfin_puid }}
GID={{ jellyfin_pgid }}
RENDER_GID={{ jellyfin_render_gid }}
TZ={{ base_timezone }}
MEDIA_SHARE={{ hdd_union_mount }}
CONFIG_DIR={{ ssd_pool_mount }}/appdata/jellyfin
TRANSCODE_DIR={{ ssd_pool_mount }}/transcode

# issue 014 — download automation (gluetun + qBittorrent + *arr + Jellyseerr).
APPDATA_DIR={{ arr_appdata_dir }}
DOWNLOADS_SHARE={{ arr_downloads_dir }}
GLUETUN_VPN_SERVICE_PROVIDER={{ gluetun_vpn_provider }}
GLUETUN_SERVER_COUNTRIES={{ gluetun_server_countries }}
WIREGUARD_PRIVATE_KEY={{ wireguard_private_key }}
WIREGUARD_ADDRESS={{ wireguard_address }}

# issue 018 — Homepage dashboard. Config on the SSD appdata tier; widget secrets
# from sops (radarr/sonarr keys; qbit WebUI creds — username non-secret, default
# admin). These feed the HOMEPAGE_VAR_* env in the homepage service.
HOMEPAGE_CONFIG_DIR={{ ssd_pool_mount }}/appdata/homepage
RADARR_API_KEY={{ radarr_api_key }}
SONARR_API_KEY={{ sonarr_api_key }}
QBIT_WEBUI_USER={{ qbittorrent_webui_username | default('admin') }}
QBIT_WEBUI_PASS={{ qbittorrent_webui_password }}
PAPERLESS_API_KEY={{ paperless_api_key }}

# issue 006 — Immich (CPU ML, mesh-only). Library + Postgres on the SSD 'immich'
# precious subvol. Vars namespaced IMMICH_* so nothing collides with a future second
# stack's DB_*/REDIS_* vars in this shared .env. IMMICH_DB_PASSWORD is sops-sourced
# and has no default here (undefined -> render fails), so a deploy cannot silently
# come up without the secret.
IMMICH_VERSION={{ immich_version }}
IMMICH_UPLOAD_LOCATION={{ immich_upload_location }}
IMMICH_DB_LOCATION={{ immich_db_location }}
IMMICH_DB_USERNAME={{ immich_db_username }}
IMMICH_DB_NAME={{ immich_db_name }}
IMMICH_DB_PASSWORD={{ immich_db_password }}

# issue 007 — Paperless-ngx (document ingest / OCR / search, mesh-only). Data + Postgres
# on the SSD 'paperless' precious subvol. Compose-substitution vars namespaced PAPERLESS_*
# (mapped into the paperless container's own PAPERLESS_* env in the compose environment:
# block). Secret key + DB password are sops-sourced with NO default here (undefined ->
# render fails), so the stack cannot silently come up without them. The admin auto-create
# vars are optional and default to empty in the compose (create the superuser manually
# post-deploy if they are unset).
PAPERLESS_VERSION={{ paperless_version }}
PAPERLESS_DATA_ROOT={{ paperless_data_root }}
PAPERLESS_OCR_LANGUAGE={{ paperless_ocr_language }}
PAPERLESS_OCR_INSTALL_LANGS={{ paperless_ocr_install_langs }}
PAPERLESS_USERMAP_UID={{ paperless_usermap_uid }}
PAPERLESS_USERMAP_GID={{ paperless_usermap_gid }}
PAPERLESS_DB_USERNAME={{ paperless_db_username }}
PAPERLESS_DB_NAME={{ paperless_db_name }}
PAPERLESS_DB_PASSWORD={{ paperless_db_password }}
PAPERLESS_SECRET_KEY={{ paperless_secret_key }}
PAPERLESS_ADMIN_USER={{ paperless_admin_user | default('') }}
PAPERLESS_ADMIN_PASSWORD={{ paperless_admin_password | default('') }}

# issue 044 — paperless-gpt + Ollama (local-LLM title/tag suggestions for Paperless).
# paperless-gpt's API token reuses PAPERLESS_API_KEY (set above, issue 018). Image tags
# and the model name are non-secret config; no new secret is introduced. Ollama has no
# secret. The model is pulled into Ollama by a compose-stack task after the stack is up.
OLLAMA_VERSION={{ ollama_version }}
PAPERLESS_GPT_VERSION={{ paperless_gpt_version }}
PAPERLESS_GPT_LLM_MODEL={{ paperless_gpt_llm_model }}

# issue 029 — Proton Mail Bridge (Paperless mail-ingest). Only the bind path is needed;
# the shenxn deb image uses a passphraseless keyring, so there is no secret to source.
PROTONMAIL_BRIDGE_DATA={{ protonmail_bridge_data }}

# hermes-helium ticket 019 — Hermes agent. Only the bind path is needed for now: no
# provider key, no Telegram token exist yet (needs-human tickets 016/017), so there
# is nothing secret to source here. The compose service passes only non-secrets
# (HERMES_UID/GID, TZ); a future ticket adds the sops-fed .env *inside* the state
# volume (ticket 03's design) once real secrets exist.
HERMES_DATA={{ hermes_data }}

# issue 048 — Audiobookshelf (audiobook server, mesh-only). Config/metadata on the
# SSD appdata tier; library read-only from the HDD media pool. No secret — the admin
# account is created interactively on first visit, same as Jellyfin.
AUDIOBOOKSHELF_VERSION={{ audiobookshelf_version }}
AUDIOBOOKSHELF_CONFIG_DIR={{ ssd_pool_mount }}/appdata/audiobookshelf/config
AUDIOBOOKSHELF_METADATA_DIR={{ ssd_pool_mount }}/appdata/audiobookshelf/metadata
AUDIOBOOKS_LIBRARY_DIR={{ audiobooks_library_dir }}

# issue 046 — MQTT credentials for the metrics publishers. Broker is the Mosquitto
# add-on on the HA box (see host_vars for why it is addressed by IP, not by name).
# Consumed here by docker2mqtt; the host-side vitals collector gets the same values
# through its own root-only environment file rendered by the mqtt_metrics role, not
# from this file (it is not a compose service and must not depend on the stack's .env).
# No $-escaping: the password is hex, and blanket-escaping would corrupt env_file use.
MQTT_BROKER_HOST={{ mqtt_broker_host }}
MQTT_BROKER_PORT={{ mqtt_broker_port }}
MQTT_USERNAME={{ mqtt_username }}
MQTT_PASSWORD={{ mqtt_password }}
