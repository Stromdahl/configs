# Rendered by Ansible from roles/compose_stack/templates/hermes.env.j2.
# hermes-helium ticket 016 — Hermes' OWN .env, inside its state volume at
# $HERMES_HOME/.env (NOT compose's stack .env). Verified in the image source
# (hermes_cli/env_loader.py:load_hermes_dotenv): the gateway loads this file via
# python-dotenv at `Path(HERMES_HOME) / ".env"` on every hot entrypoint, so this
# is the correct and only place a provider credential belongs (ticket 03's
# design, ticket 09's D4). Mode 0600, owner 1000:1000 — never in compose
# `environment:` (would land in `docker inspect`, readable via the socket proxy).
#
# Single-quoted values: cron gathering scripts (from ticket 02's recovered shape)
# `.`-source this file in bash — unquoted or double-quoted values would let a `$`
# in a token undergo shell expansion.
#
ANTHROPIC_API_KEY='{{ anthropic_api_key }}'

# hermes-helium ticket 020 — Telegram pull mode, DM-only. TELEGRAM_BOT_TOKEN's
# presence alone auto-enables the platform (gateway/config.py's
# _apply_env_overrides: `if telegram_token: _enable_from_env(...)`) — verified in
# the image source, so config.yaml's platforms block stays untouched (it ships
# commented out and would win over env if anyone uncommented it, per ticket 10's
# D2). TELEGRAM_ALLOWED_USERS is the DM allowlist: one numeric id, from ticket
# 017. TELEGRAM_ALLOWED_CHATS=0 is ticket 10's measured sentinel — not a
# reachable chat id — that blocks all five group shapes while leaving DMs
# untouched. TELEGRAM_GROUP_ALLOWED_CHATS must stay UNSET: it is the opposite
# knob (opts specific groups back in) and setting it, even to 0, does not carry
# the same meaning. guest_mode is left at its default (false) — never enable it,
# it is the one bypass around all of the above.
TELEGRAM_BOT_TOKEN='{{ telegram_bot_token }}'
TELEGRAM_ALLOWED_USERS='{{ telegram_user_id }}'
TELEGRAM_ALLOWED_CHATS='0'
