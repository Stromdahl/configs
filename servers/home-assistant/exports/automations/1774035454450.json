{
  "id": "1774035454450",
  "alias": "Light Auto: Track ambient brightness",
  "description": "",
  "triggers": [
    {
      "trigger": "state",
      "entity_id": [
        "sensor.brightness"
      ]
    },
    {
      "trigger": "time_pattern",
      "minutes": "/10"
    },
    {
      "trigger": "state",
      "entity_id": [
        "input_boolean.auto_brightness_on"
      ],
      "to": [
        "on"
      ],
      "from": [
        "off"
      ]
    }
  ],
  "conditions": [
    {
      "condition": "state",
      "entity_id": "input_boolean.auto_brightness_on",
      "state": [
        "on"
      ]
    }
  ],
  "actions": [
    {
      "action": "light.turn_on",
      "target": {
        "entity_id": "light.light_auto"
      },
      "data": {
        "brightness": "{{ states('sensor.brightness') | int(0) }}",
        "transition": 2
      }
    }
  ],
  "mode": "single"
}
