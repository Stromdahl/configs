# Rendered by Ansible from roles/compose_stack/templates/docker-compose.yml.j2.
# This file is committed to git — no secrets inline. All ${VAR} references
# are resolved at `docker compose` run time from {{ compose_stack_dir }}/.env
# (rendered to 0600 with the sops-decrypted secrets).
#
# Services: docker-socket-proxy, traefik, jellyfin (issue 005) + gluetun,
# qbittorrent, prowlarr, flaresolverr, radarr, sonarr, bazarr, profilarr,
# jellyseerr (issue 014) + homepage (issue 018) + immich-server,
# immich-machine-learning, immich-redis, immich-database (issue 006) +
# paperless + paperless-redis/db/gotenberg/tika (issue 007) + cleanuparr
# (issue 017).
# Excluded vs neon: homer, the alpine `test` probe, the commented `backup`.
#
# Divergences from neon's compose:
#   - Network renamed gluetun_network -> media (plain bridge, no VPN dependency)
#   - Jellyfin router rule uses jellyfin.${DOMAIN} (neon used bare ${DOMAIN})
#   - Jellyfin group_add: ["${RENDER_GID}"] for iGPU/QuickSync render group
#   - Jellyfin volumes: bind mounts to helium SSD/HDD tiers (not named volumes)
#   - Jellyfin /media volume is :ro (media share is read-only)
#   - Traefik acme.json kept in named volume `traefik_certs` (same as neon);
#     a bind mount would land world-readable (644) and Traefik refuses it
#   - Traefik dynamic.yml bind mount uses relative path ./config/traefik/
#     (resolves to {{ compose_stack_dir }}/config/traefik/ given -f flag)
#
# Post-deploy human steps:
#   - Jellyfin Dashboard > Playback: set Transcoding temp path to /transcode
#   - Verify jellyfin.${DOMAIN} resolves from a NetBird peer (not from LAN)
#   - Verify traefik.${DOMAIN} dashboard is accessible over mesh
name: helium

# issue 010 — non-root / least-privilege hardening. Curated capability set for images
# whose entrypoint starts as root and drops to a non-root user (linuxserver s6-overlay;
# official postgres/redis/valkey via gosu; paperless via su-exec): CHOWN + DAC_OVERRIDE +
# FOWNER cover the init-time chown of the /config|data dir; SETGID + SETUID cover the
# privilege drop itself. A blanket cap_drop:[ALL] WITHOUT these BREAKS the drop — a uid-0
# process with an empty capability set cannot setuid()/setgid() (the kernel gates those on
# CAP_SETUID/CAP_SETGID, not on euid==0), so the app crash-loops or silently stays root.
# This is the linuxserver / official-image hardening posture, and it deliberately diverges
# from the frozen task-brief matrix's literal (broken) "cap_drop:[ALL], no cap_add".
# Images that run directly as a fixed non-root uid (flaresolverr, jellyseerr) or that stay
# root by design (immich, docker-socket-proxy) take cap_drop:[ALL] with NO cap_add.
x-caps-privdrop: &caps-privdrop [CHOWN, DAC_OVERRIDE, FOWNER, SETGID, SETUID]

networks:
  media:
  socket_proxy:
  # issue 006 — dedicated internal bridge for Immich's backends (db/redis/ML never
  # join the shared media bridge); immich-server is dual-homed on media for Traefik.
  immich:
  # issue 007 — dedicated internal bridge for Paperless's backends (redis/postgres/
  # gotenberg/tika never join the shared media bridge); the webserver is dual-homed on
  # media for Traefik.
  paperless:

volumes:
  traefik_certs:
  # issue 006 — Immich ML model cache (CLIP + face models); persist across redeploys.
  immich_model_cache:
  # issue 007 — Paperless's Redis (task queue) data; persist so in-flight consume tasks
  # survive a restart. Not precious -> a named volume on the OS disk, not the SSD subvol.
  paperless_redis:

secrets:
  cf_dns_api_token:
    environment: CF_DNS_API_TOKEN

services:

  docker-socket-proxy:
    image: tecnativa/docker-socket-proxy:v0.4.2
    container_name: docker-socket-proxy
    restart: unless-stopped
    # issue 010: stays root to read the root:docker-owned /var/run/docker.sock (uid 0 is the
    # socket owner -> no DAC_OVERRIDE needed); haproxy binds 2375 (>1024, no NET_BIND_SERVICE).
    # It IS the socket-access boundary, so no cap is required beyond the empty set.
    cap_drop:
      - ALL
    security_opt:
      - "no-new-privileges:true"
    environment:
      - CONTAINERS=1
      - NETWORKS=1
      - SERVICES=0
      - TASKS=0
      - INFO=1
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - socket_proxy

  traefik:
    image: traefik:v3.6.23
    container_name: traefik
    restart: unless-stopped
    # issue 010: DOCUMENTED root exception. Traefik must bind privileged ports 80/443 —
    # which requires CAP_NET_BIND_SERVICE even as uid 0 (an empty cap set cannot bind <1024) —
    # and it owns acme.json (0600) inside the root-owned traefik_certs named volume. Running
    # non-root (65534) would additionally need ambient-cap plumbing for the bind and a chown of
    # the existing acme.json volume; on the reverse proxy whose failure = total outage that is
    # not worth the live-box risk. Drop everything else.
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - "no-new-privileges:true"
    depends_on:
      - docker-socket-proxy
    command:
      - "--api.dashboard=true"
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--providers.docker.endpoint=tcp://docker-socket-proxy:2375"
      - "--providers.file.filename=/etc/traefik/dynamic.yml"
      - "--entrypoints.web.address=:80"
      - "--entryPoints.web.http.redirections.entryPoint.to=websecure"
      - "--entryPoints.web.http.redirections.entryPoint.scheme=https"
      - "--entryPoints.web.http.redirections.entryPoint.permanent=true"
      - "--entrypoints.websecure.address=:443"
      - "--certificatesresolvers.letsencrypt.acme.dnschallenge.provider=cloudflare"
      - "--certificatesresolvers.letsencrypt.acme.email=${ACME_EMAIL:?missing ACME_EMAIL}"
      - "--certificatesresolvers.letsencrypt.acme.storage=/letsencrypt/acme.json"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.dashboard.rule=Host(`traefik.${DOMAIN:?missing DOMAIN}`)"
      - "traefik.http.routers.dashboard.entrypoints=websecure"
      - "traefik.http.routers.dashboard.tls.certresolver=letsencrypt"
      - "traefik.http.routers.dashboard.service=api@internal"
      - "traefik.http.routers.dashboard.middlewares=dashboard-auth,security-headers@file"
      - "traefik.http.middlewares.dashboard-auth.basicauth.users=${TRAEFIK_DASHBOARD_AUTH:?missing TRAEFIK_DASHBOARD_AUTH}"
    ports:
      - "80:80"
      - "443:443"
    secrets:
      - cf_dns_api_token
    environment:
      # CF token passed as a mounted file, not a plain env var.
      # Plain env vars are visible via `docker inspect`; the _FILE variant
      # is read from the secrets tmpfs mount — not in the process environment.
      - CF_DNS_API_TOKEN_FILE=/run/secrets/cf_dns_api_token
    volumes:
      # acme.json lives in a named volume so Docker owns its permissions (600).
      # A bind-mounted file would be created 644 by Ansible and Traefik refuses
      # "permissions are too open" on startup.
      - traefik_certs:/letsencrypt
      - ./config/traefik/dynamic.yml:/etc/traefik/dynamic.yml:ro
    networks:
      - media
      - socket_proxy

  jellyfin:
    image: ghcr.io/linuxserver/jellyfin:10.11.8
    container_name: jellyfin
    restart: unless-stopped
    # issue 010: linuxserver s6 init drops to PUID 1001 -> curated caps (see anchor). Caps do
    # NOT gate /dev/dri (device cgroup + render group do) and no-new-privileges does not affect
    # group_add, so QuickSync/QSV is preserved.
    cap_drop:
      - ALL
    cap_add: *caps-privdrop
    security_opt:
      - "no-new-privileges:true"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.jellyfin.rule=Host(`jellyfin.${DOMAIN:?missing DOMAIN}`)"
      - "traefik.http.routers.jellyfin.entrypoints=websecure"
      - "traefik.http.routers.jellyfin.tls.certresolver=letsencrypt"
      - "traefik.http.services.jellyfin.loadbalancer.server.port=8096"
      - "traefik.http.routers.jellyfin.middlewares=jellyfin-headers@file"
    healthcheck:
      test: ["CMD-SHELL", "curl -fs http://localhost:8096/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    environment:
      - PUID=${UID:?missing UID}
      - PGID=${GID:?missing GID}
      - TZ=${TZ:-Europe/Stockholm}
    # iGPU/QuickSync: add the render group so Jellyfin can open /dev/dri/renderD128.
    # The GID is host-specific — read from `getent group render | cut -d: -f3` on
    # helium and set jellyfin_render_gid in host_vars/helium/vars.yml.
    group_add:
      - "${RENDER_GID:?missing RENDER_GID}"
    devices:
      - /dev/dri:/dev/dri  # Required for Jellyfin HW transcoding / QuickSync
    volumes:
      - ${CONFIG_DIR:?missing CONFIG_DIR}:/config
      # Media share is read-only — Jellyfin must never write to the HDD union.
      - ${MEDIA_SHARE:?missing MEDIA_SHARE}:/media:ro
      # Transcode scratch on SSD (nodatacow subvolume). After first start:
      # Jellyfin Dashboard > Playback > Transcoding temp path -> /transcode
      - ${TRANSCODE_DIR:?missing TRANSCODE_DIR}:/transcode
    networks:
      - media

  # ===========================================================================
  # issue 018 — Homepage: single-pane dashboard (grouped links + live health +
  # API-fed widgets). On the `media` bridge (reaches every service by container
  # name; qbit/prowlarr AT gluetun's name) AND `socket_proxy` (container status
  # over TCP via docker-socket-proxy, never the raw socket). No published ports —
  # reached only through Traefik at homepage.${DOMAIN}. Runs non-root as the
  # jellyfin uid/gid (owns its config dir on the SSD appdata tier).
  #   - Config files are copied verbatim by the role (issue 018); their
  #     HOMEPAGE_VAR_* placeholders resolve from the environment below.
  #   - No healthcheck: Homepage's HOMEPAGE_ALLOWED_HOSTS rejects a localhost
  #     Host header, which a naive wget probe would send. restart + Traefik suffice.
  homepage:
    image: ghcr.io/gethomepage/homepage:v1.13.2
    container_name: homepage
    restart: unless-stopped
    # issue 010: entrypoint drops to PUID 1001 (su-exec) -> curated caps (see anchor).
    cap_drop:
      - ALL
    cap_add: *caps-privdrop
    security_opt:
      - "no-new-privileges:true"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.homepage.rule=Host(`homepage.${DOMAIN:?missing DOMAIN}`)"
      - "traefik.http.routers.homepage.entrypoints=websecure"
      - "traefik.http.routers.homepage.tls.certresolver=letsencrypt"
      - "traefik.http.services.homepage.loadbalancer.server.port=3000"
      - "traefik.http.routers.homepage.middlewares=security-headers@file"
    environment:
      - PUID=${UID:?missing UID}
      - PGID=${GID:?missing GID}
      - TZ=${TZ:-Europe/Stockholm}
      # Host-header allowlist (required since Homepage 0.9.13). Must match the
      # Traefik router host exactly, or Homepage returns a 400.
      - HOMEPAGE_ALLOWED_HOSTS=homepage.${DOMAIN:?missing DOMAIN}
      # Secrets for the API-fed widgets, injected as HOMEPAGE_VAR_* and referenced
      # as HOMEPAGE_VAR_* placeholders in services.yaml. Sourced from sops via .env.
      - HOMEPAGE_VAR_RADARR_KEY=${RADARR_API_KEY:?missing RADARR_API_KEY}
      - HOMEPAGE_VAR_SONARR_KEY=${SONARR_API_KEY:?missing SONARR_API_KEY}
      - HOMEPAGE_VAR_QBIT_USER=${QBIT_WEBUI_USER:-admin}
      - HOMEPAGE_VAR_QBIT_PASS=${QBIT_WEBUI_PASS:?missing QBIT_WEBUI_PASS}
      - HOMEPAGE_VAR_PAPERLESS_KEY=${PAPERLESS_API_KEY:?missing PAPERLESS_API_KEY}
    volumes:
      - ${HOMEPAGE_CONFIG_DIR:?missing HOMEPAGE_CONFIG_DIR}:/app/config
      # Read-only mount of the HDD union so the resources widget can statvfs the
      # HDD tier. (The SSD tier is read via /app/config, already on that pool.)
      - ${MEDIA_SHARE:?missing MEDIA_SHARE}:/mnt/media:ro
    networks:
      - media
      - socket_proxy

  # ===========================================================================
  # issue 014 — download automation: gluetun + qBittorrent + *arr + Jellyseerr.
  # Adapted from neon's compose with these helium divergences:
  #   - Network gluetun_network -> media (the existing bridge from issue 005).
  #   - Subdomain-per-service Traefik routing (neon used PathPrefix for the *arr);
  #     the *.${DOMAIN} wildcard cert + DNS already cover every new host.
  #   - NO host-published ports anywhere. Under compose_restrict_to_mesh=false
  #     there is no DOCKER-USER LAN drop, so a published port would be LAN-reachable
  #     (014 AC: "no published port leaks"). qBittorrent (8080) and Prowlarr (9696)
  #     share gluetun's netns, so their Traefik routers/labels ride on the gluetun
  #     container and Traefik reaches them over the `media` bridge by container name.
  #   - Bind mounts to helium tiers (not named volumes): config -> SSD appdata,
  #     downloads -> SSD scratch, media -> HDD union. downloads and media are two
  #     filesystems => imports are copy-then-delete (accepted; see issue 014).
  #   - radarr/sonarr/bazarr do NOT depend_on qbit health -> *arr WebUI availability
  #     is decoupled from VPN/qbit state.
  # gluetun firewall: Traefik and the bridge *arr share gluetun's connected `media`
  # subnet, which gluetun auto-allows (neon worked the same way with no FIREWALL_*).
  # If Traefik 502s to qbit/prowlarr, or prowlarr can't sync to the *arr, add to
  # gluetun: FIREWALL_INPUT_PORTS=8080,9696 and FIREWALL_OUTBOUND_SUBNETS=<media subnet>.
  # ===========================================================================

  gluetun:
    image: qmcgaw/gluetun:v3.41.1
    container_name: gluetun
    restart: unless-stopped
    # issue 010: DOCUMENTED privileged exception. NET_ADMIN + /dev/net/tun are required for the
    # WireGuard tunnel, routing table, and iptables kill-switch — drop everything else. This is
    # the netns provider for qbittorrent/prowlarr/flaresolverr, so it has the largest blast
    # radius of any change here; if it fails to go healthy, its log names the missing cap.
    cap_drop:
      - ALL
    cap_add:
      - NET_ADMIN
    security_opt:
      - "no-new-privileges:true"
    devices:
      - /dev/net/tun:/dev/net/tun
    # No custom healthcheck: the gluetun image ships a provider-agnostic built-in
    # (/gluetun-entrypoint healthcheck) that reports healthy once the tunnel passes
    # traffic. (neon overrode it with a Mullvad-specific am.i.mullvad.net probe,
    # which would never pass on Proton.)
    environment:
      - VPN_SERVICE_PROVIDER=${GLUETUN_VPN_SERVICE_PROVIDER:?missing GLUETUN_VPN_SERVICE_PROVIDER}
      - VPN_TYPE=wireguard
      # Proton WireGuard PrivateKey + Address from a generated Proton config (sops).
      - WIREGUARD_PRIVATE_KEY=${WIREGUARD_PRIVATE_KEY:?missing WIREGUARD_PRIVATE_KEY}
      - WIREGUARD_ADDRESSES=${WIREGUARD_ADDRESS:?missing WIREGUARD_ADDRESS}
      - SERVER_COUNTRIES=${GLUETUN_SERVER_COUNTRIES:?missing GLUETUN_SERVER_COUNTRIES}
      # issue 014: ProtonVPN port forwarding (NAT-PMP) so qBittorrent gets an inbound
      # port -> better connectability on thin swarms. Requires the WireGuard config to
      # have been generated with NAT-PMP enabled (sops key). PORT_FORWARD_ONLY makes
      # gluetun only connect to PF-capable Sweden servers.
      - VPN_PORT_FORWARDING=on
      - VPN_PORT_FORWARDING_PROVIDER=protonvpn
      - PORT_FORWARD_ONLY=on
      # issue 010 interaction: cap_drop:ALL removes root's DAC_OVERRIDE + CAP_CHOWN, so
      # gluetun (a) can't write its default /tmp/gluetun dir (created mode 0644, no +x)
      # and (b) can't chown the forwarded_port file to PUID -> the PF renewal service
      # dies. Fix WITHOUT re-adding caps: write both state files to /tmp (1777,
      # world-writable), and set PUID/PGID=0 so the post-write chown is root->root — a
      # same-owner chown the kernel allows without CAP_CHOWN. gluetun's main process
      # already runs as root (NET_ADMIN), so this changes only its file-write uid.
      - VPN_PORT_FORWARDING_STATUS_FILE=/tmp/forwarded_port
      - PUBLICIP_FILE=/tmp/ip
      - PUID=0
      - PGID=0
      - TZ=${TZ:-Europe/Stockholm}
    labels:
      - "traefik.enable=true"
      # qBittorrent WebUI (shares gluetun netns) -> qbittorrent.${DOMAIN}
      - "traefik.http.routers.qbittorrent.rule=Host(`qbittorrent.${DOMAIN:?missing DOMAIN}`)"
      - "traefik.http.routers.qbittorrent.entrypoints=websecure"
      - "traefik.http.routers.qbittorrent.tls.certresolver=letsencrypt"
      - "traefik.http.routers.qbittorrent.service=qbittorrent"
      - "traefik.http.services.qbittorrent.loadbalancer.server.port=8080"
      - "traefik.http.routers.qbittorrent.middlewares=security-headers@file"
      # Prowlarr (shares gluetun netns) -> prowlarr.${DOMAIN}
      - "traefik.http.routers.prowlarr.rule=Host(`prowlarr.${DOMAIN:?missing DOMAIN}`)"
      - "traefik.http.routers.prowlarr.entrypoints=websecure"
      - "traefik.http.routers.prowlarr.tls.certresolver=letsencrypt"
      - "traefik.http.routers.prowlarr.service=prowlarr"
      - "traefik.http.services.prowlarr.loadbalancer.server.port=9696"
      - "traefik.http.routers.prowlarr.middlewares=security-headers@file"
    networks:
      - media

  qbittorrent:
    image: lscr.io/linuxserver/qbittorrent:5.1.4
    container_name: qbittorrent
    restart: unless-stopped
    # issue 010: linuxserver s6 -> PUID 1001, curated caps (see anchor). No NET caps despite
    # torrenting: it uses gluetun's network namespace, so its net stack is gluetun's.
    cap_drop:
      - ALL
    cap_add: *caps-privdrop
    security_opt:
      - "no-new-privileges:true"
    # Shares gluetun's network stack -> all torrent traffic egresses via the VPN;
    # if gluetun stops, qbit loses connectivity (kill-switch).
    network_mode: "service:gluetun"
    depends_on:
      gluetun:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:8080 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    environment:
      - PUID=${UID:?missing UID}
      - PGID=${GID:?missing GID}
      - TZ=${TZ:-Europe/Stockholm}
      - WEBUI_PORT=8080
    volumes:
      - ${APPDATA_DIR:?missing APPDATA_DIR}/qbittorrent:/config
      - ${DOWNLOADS_SHARE:?missing DOWNLOADS_SHARE}:/downloads

  prowlarr:
    image: lscr.io/linuxserver/prowlarr:2.3.5
    container_name: prowlarr
    restart: unless-stopped
    # issue 010: linuxserver s6 -> PUID 1001, curated caps (see anchor); uses gluetun's netns.
    cap_drop:
      - ALL
    cap_add: *caps-privdrop
    security_opt:
      - "no-new-privileges:true"
    network_mode: "service:gluetun"
    depends_on:
      gluetun:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:9696/ping || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    environment:
      - PUID=${UID:?missing UID}
      - PGID=${GID:?missing GID}
      - TZ=${TZ:-Europe/Stockholm}
    volumes:
      - ${APPDATA_DIR:?missing APPDATA_DIR}/prowlarr:/config

  # Cloudflare/DDoS-GUARD solver used by Prowlarr; internal only (no Traefik route).
  flaresolverr:
    image: flaresolverr/flaresolverr:v3.4.6
    container_name: flaresolverr
    restart: unless-stopped
    # issue 010: image already runs directly as non-root (uid 1000), so no privilege-drop cap
    # is needed -> cap_drop:[ALL], no cap_add. Runs headless Chromium with --no-sandbox, so the
    # dropped caps + no-new-privileges do not touch a sandbox it isn't using. Uses gluetun's netns.
    cap_drop:
      - ALL
    security_opt:
      - "no-new-privileges:true"
    network_mode: "service:gluetun"
    depends_on:
      gluetun:
        condition: service_healthy
    healthcheck:
      # flaresolverr image ships no wget; python3 (present) probes /health instead.
      test: ["CMD", "python3", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8191/health', timeout=5)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    environment:
      - LOG_LEVEL=info
      - LOG_HTML=false
      - CAPTCHA_SOLVER=none
      - TZ=${TZ:-Europe/Stockholm}
      - LANG=en_GB
      - DRIVER=nodriver

  radarr:
    image: lscr.io/linuxserver/radarr:6.1.1
    container_name: radarr
    restart: unless-stopped
    # issue 010: linuxserver s6 -> PUID 1001, curated caps (see anchor). /data/media stays RW
    # (radarr imports/renames into the library), so it is NOT made read-only.
    cap_drop:
      - ALL
    cap_add: *caps-privdrop
    security_opt:
      - "no-new-privileges:true"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.radarr.rule=Host(`radarr.${DOMAIN:?missing DOMAIN}`)"
      - "traefik.http.routers.radarr.entrypoints=websecure"
      - "traefik.http.routers.radarr.tls.certresolver=letsencrypt"
      - "traefik.http.services.radarr.loadbalancer.server.port=7878"
      - "traefik.http.routers.radarr.middlewares=security-headers@file"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:7878/ping || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    environment:
      - PUID=${UID:?missing UID}
      - PGID=${GID:?missing GID}
      - TZ=${TZ:-Europe/Stockholm}
    volumes:
      - ${APPDATA_DIR:?missing APPDATA_DIR}/radarr:/config
      - ${MEDIA_SHARE:?missing MEDIA_SHARE}:/data/media
      - ${DOWNLOADS_SHARE:?missing DOWNLOADS_SHARE}:/downloads
    networks:
      - media

  sonarr:
    image: lscr.io/linuxserver/sonarr:4.0.17
    container_name: sonarr
    restart: unless-stopped
    # issue 010: linuxserver s6 -> PUID 1001, curated caps (see anchor). /data/media stays RW.
    cap_drop:
      - ALL
    cap_add: *caps-privdrop
    security_opt:
      - "no-new-privileges:true"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.sonarr.rule=Host(`sonarr.${DOMAIN:?missing DOMAIN}`)"
      - "traefik.http.routers.sonarr.entrypoints=websecure"
      - "traefik.http.routers.sonarr.tls.certresolver=letsencrypt"
      - "traefik.http.services.sonarr.loadbalancer.server.port=8989"
      - "traefik.http.routers.sonarr.middlewares=security-headers@file"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:8989/ping || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    environment:
      - PUID=${UID:?missing UID}
      - PGID=${GID:?missing GID}
      - TZ=${TZ:-Europe/Stockholm}
    volumes:
      - ${APPDATA_DIR:?missing APPDATA_DIR}/sonarr:/config
      - ${MEDIA_SHARE:?missing MEDIA_SHARE}:/data/media
      - ${DOWNLOADS_SHARE:?missing DOWNLOADS_SHARE}:/downloads
    networks:
      - media

  bazarr:
    image: lscr.io/linuxserver/bazarr:1.5.6
    container_name: bazarr
    restart: unless-stopped
    # issue 010: linuxserver s6 -> PUID 1001, curated caps (see anchor). /data/media stays RW
    # (bazarr writes sidecar subtitle files alongside the media).
    cap_drop:
      - ALL
    cap_add: *caps-privdrop
    security_opt:
      - "no-new-privileges:true"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.bazarr.rule=Host(`bazarr.${DOMAIN:?missing DOMAIN}`)"
      - "traefik.http.routers.bazarr.entrypoints=websecure"
      - "traefik.http.routers.bazarr.tls.certresolver=letsencrypt"
      - "traefik.http.services.bazarr.loadbalancer.server.port=6767"
      - "traefik.http.routers.bazarr.middlewares=security-headers@file"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:6767/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    environment:
      - PUID=${UID:?missing UID}
      - PGID=${GID:?missing GID}
      - TZ=${TZ:-Europe/Stockholm}
    volumes:
      - ${APPDATA_DIR:?missing APPDATA_DIR}/bazarr:/config
      # Bazarr writes sidecar subtitle files alongside the media -> RW.
      # (Deviates from the issue brief's ':ro', which would break subtitle saving.)
      - ${MEDIA_SHARE:?missing MEDIA_SHARE}:/data/media
    networks:
      - media

  profilarr:
    image: santiagosayshey/profilarr:v1.1.4
    container_name: profilarr
    restart: unless-stopped
    # issue 010: honors PUID/PGID; curated caps are the safe superset whether it drops from
    # root or runs directly (harmless/inert if unused). Runtime uid unchanged -> no chown.
    cap_drop:
      - ALL
    cap_add: *caps-privdrop
    security_opt:
      - "no-new-privileges:true"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.profilarr.rule=Host(`profilarr.${DOMAIN:?missing DOMAIN}`)"
      - "traefik.http.routers.profilarr.entrypoints=websecure"
      - "traefik.http.routers.profilarr.tls.certresolver=letsencrypt"
      - "traefik.http.services.profilarr.loadbalancer.server.port=6868"
      - "traefik.http.routers.profilarr.middlewares=security-headers@file"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:6868/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    environment:
      - PUID=${UID:?missing UID}
      - PGID=${GID:?missing GID}
      - TZ=${TZ:-Europe/Stockholm}
    volumes:
      - ${APPDATA_DIR:?missing APPDATA_DIR}/profilarr:/config
    networks:
      - media

  jellyseerr:
    image: fallenbagel/jellyseerr:2.7.3
    container_name: jellyseerr
    restart: unless-stopped
    # issue 010: upstream image has NO privilege drop and ran as container-root. Flip it to the
    # jellyfin uid/gid directly (runs as 1001, no drop -> no cap_add). Its /app/config (sqlite
    # settings + request db) was written root-owned, so the compose_stack role recursively chowns
    # it to 1001:1003 BEFORE this recreate (see stack.yml) or jellyseerr can't read its own state.
    user: "${UID:?missing UID}:${GID:?missing GID}"
    cap_drop:
      - ALL
    security_opt:
      - "no-new-privileges:true"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.jellyseerr.rule=Host(`jellyseerr.${DOMAIN:?missing DOMAIN}`)"
      - "traefik.http.routers.jellyseerr.entrypoints=websecure"
      - "traefik.http.routers.jellyseerr.tls.certresolver=letsencrypt"
      - "traefik.http.services.jellyseerr.loadbalancer.server.port=5055"
      - "traefik.http.routers.jellyseerr.middlewares=security-headers@file"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:5055/api/v1/status || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    environment:
      - TZ=${TZ:-Europe/Stockholm}
    volumes:
      - ${APPDATA_DIR:?missing APPDATA_DIR}/jellyseerr:/app/config
    networks:
      - media

  # ===========================================================================
  # issue 017 — Cleanuparr: download hygiene for the issue-014 stack. Monitors
  # the Radarr/Sonarr queues and qBittorrent; on repeated stall/failed-import
  # strikes it removes the download from qBittorrent, blocklists the release in
  # the *arr (blocklist=true is hardcoded in Cleanuparr's queue-delete call) so
  # it is not re-grabbed, and triggers a fresh search. Successor to Decluttarr.
  #   - Reuses the EXISTING qBittorrent WebUI creds + Radarr/Sonarr API keys
  #     from issue 014 (read from each app's config.xml / sops on-box; never
  #     re-keyed). Cleanuparr's own admin login is a NEW identity (like the
  #     Immich/Paperless admin) — minted into secrets.sops.yml, NOT a container
  #     env var (Cleanuparr has no ADMIN_USER/PASSWORD env — the account is
  #     created once via its own /api/auth/setup/account, post-deploy).
  #   - All business config (download-client + arr-app connections, the queue
  #     cleaner schedule + stall rule) lives in Cleanuparr's own sqlite db under
  #     /config — set once via its REST API (schema-driven, same discipline as
  #     014's app config), not via env vars or a seeded file.
  #   - DownloadCleaner (orphaned-file pruning / seeding rules) is deliberately
  #     LEFT DISABLED (its default state): it would delete files under the live
  #     downloads dir on an unvetted rule set — real blast radius, and not an
  #     issue-017 AC. No /downloads mount either, since nothing here needs it
  #     while that feature is off. Only the QueueCleaner (stalled/failed queue
  #     items) is enabled — exactly what the ACs require and verify.
  #   - No published port; Traefik-only at cleanuparr.${DOMAIN}, same boundary
  #     as every other service in this stack (LAN + mesh, never public).
  # ===========================================================================

  cleanuparr:
    image: ghcr.io/cleanuparr/cleanuparr:2.9.14
    container_name: cleanuparr
    restart: unless-stopped
    # issue 010: honors PUID/PGID (1001); curated caps are the safe superset whether it drops
    # from root or runs directly. Runtime uid unchanged -> no chown.
    cap_drop:
      - ALL
    cap_add: *caps-privdrop
    security_opt:
      - "no-new-privileges:true"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.cleanuparr.rule=Host(`cleanuparr.${DOMAIN:?missing DOMAIN}`)"
      - "traefik.http.routers.cleanuparr.entrypoints=websecure"
      - "traefik.http.routers.cleanuparr.tls.certresolver=letsencrypt"
      - "traefik.http.services.cleanuparr.loadbalancer.server.port=11011"
      - "traefik.http.routers.cleanuparr.middlewares=security-headers@file"
    healthcheck:
      test: ["CMD-SHELL", "curl -fs http://localhost:11011/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    environment:
      - PORT=11011
      - PUID=${UID:?missing UID}
      - PGID=${GID:?missing GID}
      - TZ=${TZ:-Europe/Stockholm}
    volumes:
      - ${APPDATA_DIR:?missing APPDATA_DIR}/cleanuparr:/config
    networks:
      - media

  # ===========================================================================
  # issue 006 — Immich: private Google-Photos replacement. Four services
  # (server + machine-learning + valkey + postgres), mirroring the OFFICIAL
  # immich-app release compose (v3.0.0) with these helium divergences:
  #   - NO published ports. Upstream publishes 2283:2283; here immich-server is
  #     reached only through Traefik at immich.${DOMAIN}. Under
  #     compose_restrict_to_mesh=false a published port would be LAN-reachable
  #     (there is no DOCKER-USER drop) — same rule the issue 014 services follow.
  #   - CPU-only ML: the plain immich-machine-learning image (no -cuda/-openvino
  #     suffix) and NO `extends: hwaccel.ml.yml` block = CPU inference (the default).
  #     The RTX 2060 was pulled, so there is no CUDA path.
  #   - valkey + postgres are renamed immich-redis / immich-database (upstream calls
  #     them redis / database) so the generic names stay free for a future second
  #     stack (Paperless, issue 007). DB_HOSTNAME/REDIS_HOSTNAME on immich-server are
  #     set to the renamed hosts to match.
  #   - env_file: .env is DROPPED (upstream sets it on server + ML): the shared
  #     {{ compose_stack_dir }}/.env holds every stack's secrets, and env_file would
  #     inject all of them into the Immich containers. immich-server gets an explicit
  #     environment: block with only its own vars; ML needs none.
  #   - The four services sit on a dedicated internal `immich` bridge (db/redis/ML
  #     never touch the shared media bridge); immich-server is dual-homed on `media`
  #     so Traefik can reach it. (socket_proxy is the precedent for isolating a
  #     sensitive backend on its own network.)
  #   - Library + Postgres bind to the SSD 'immich' precious subvol. immich-server
  #     runs as root (no PUID/PGID) and writes the library as root; the postgres image
  #     self-chowns its data dir on first init — so neither dir is pre-chowned.
  #   - valkey + postgres pinned by digest exactly as the upstream release pins them
  #     (the tested pair); server + ML pinned by ${IMMICH_VERSION}.
  # Post-deploy human steps (needs-human): mint IMMICH_DB_PASSWORD into sops; add the
  # instance in the phone app over the mesh + enable auto-backup; the first CPU bulk
  # ML index (faces + CLIP smart-search) is slow — confirmed by observation over time.
  # ===========================================================================

  immich-server:
    image: ghcr.io/immich-app/immich-server:${IMMICH_VERSION:?missing IMMICH_VERSION}
    container_name: immich_server
    restart: unless-stopped
    # issue 010: DOCUMENTED root exception. Immich has no PUID/PGID; the official image runs as
    # root and writes the library (/data) as root (vars.yml). It stays root with no privilege
    # drop, so cap_drop:[ALL] with NO cap_add is safe (binds 2283 >1024; owns its own files).
    cap_drop:
      - ALL
    security_opt:
      - "no-new-privileges:true"
    depends_on:
      - immich-redis
      - immich-database
    labels:
      - "traefik.enable=true"
      # issue 009 — immich-server is dual-homed (media + immich). Without this label
      # Traefik's docker provider picks one of the two container IPs non-deterministically
      # on recreate; when it picks the immich-net IP (which Traefik isn't attached to) the
      # route silently hangs (TLS ok, backend times out). Pin it to the shared media bridge.
      # Value = the real docker network name (compose prefixes it with the project name,
      # which defaults to the deploy dir's basename).
      - "traefik.docker.network={{ compose_stack_dir | basename }}_media"
      - "traefik.http.routers.immich.rule=Host(`immich.${DOMAIN:?missing DOMAIN}`)"
      - "traefik.http.routers.immich.entrypoints=websecure"
      - "traefik.http.routers.immich.tls.certresolver=letsencrypt"
      - "traefik.http.services.immich.loadbalancer.server.port=2283"
      - "traefik.http.routers.immich.middlewares=security-headers@file"
    environment:
      # Discrete DB_* vars (not DB_URL). Hostnames are the renamed service names.
      - DB_HOSTNAME=immich-database
      - DB_USERNAME=${IMMICH_DB_USERNAME:-postgres}
      - DB_PASSWORD=${IMMICH_DB_PASSWORD:?missing IMMICH_DB_PASSWORD}
      - DB_DATABASE_NAME=${IMMICH_DB_NAME:-immich}
      - REDIS_HOSTNAME=immich-redis
      # ML reached at the default http://immich-machine-learning:3003 (service kept
      # at its upstream name, so no URL override needed).
      - TZ=${TZ:-Europe/Stockholm}
    volumes:
      # Library on the SSD 'immich' precious subvol. Internal media path is /data.
      - ${IMMICH_UPLOAD_LOCATION:?missing IMMICH_UPLOAD_LOCATION}:/data
      - /etc/localtime:/etc/localtime:ro
    networks:
      - media    # Traefik reaches immich-server here
      - immich   # db / redis / ML backends
    # Uses the image's built-in healthcheck (upstream sets healthcheck.disable=false).

  immich-machine-learning:
    image: ghcr.io/immich-app/immich-machine-learning:${IMMICH_VERSION:?missing IMMICH_VERSION}
    container_name: immich_machine_learning
    restart: unless-stopped
    # issue 010: DOCUMENTED root exception (same as immich-server). Runs as root with no drop
    # and only writes its own model cache -> cap_drop:[ALL], no cap_add.
    cap_drop:
      - ALL
    security_opt:
      - "no-new-privileges:true"
    # CPU inference: plain image, NO `extends: hwaccel.ml.yml`. Models cached in a
    # named volume so redeploys/re-pulls don't re-download the CLIP + face models.
    volumes:
      - immich_model_cache:/cache
    networks:
      - immich

  immich-redis:
    image: docker.io/valkey/valkey:9@sha256:4963247afc4cd33c7d3b2d2816b9f7f8eeebab148d29056c2ca4d7cbc966f2d9
    container_name: immich_redis
    restart: unless-stopped
    # issue 010: official valkey entrypoint starts root, chowns /data, gosu-drops to uid 999 ->
    # curated caps (see anchor). Data dir stays 999-owned; no user override, no chown.
    cap_drop:
      - ALL
    cap_add: *caps-privdrop
    security_opt:
      - "no-new-privileges:true"
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping || exit 1"]
    networks:
      - immich

  immich-database:
    image: ghcr.io/immich-app/postgres:14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23
    container_name: immich_postgres
    restart: unless-stopped
    # issue 010: official postgres entrypoint starts root, self-chowns PGDATA, gosu-drops to uid
    # 999 -> curated caps (see anchor). Deliberately NO user: override (per the frozen brief); a
    # stricter user:"999:999" + zero-cap variant exists as future tightening. PGDATA stays
    # 999-owned; no chown.
    cap_drop:
      - ALL
    cap_add: *caps-privdrop
    security_opt:
      - "no-new-privileges:true"
    environment:
      - POSTGRES_PASSWORD=${IMMICH_DB_PASSWORD:?missing IMMICH_DB_PASSWORD}
      - POSTGRES_USER=${IMMICH_DB_USERNAME:-postgres}
      - POSTGRES_DB=${IMMICH_DB_NAME:-immich}
      - POSTGRES_INITDB_ARGS=--data-checksums
    volumes:
      # Postgres data on the SSD 'immich' precious subvol (deliberate: checksums beat
      # write-amplification for a small library). The image self-chowns this on init.
      - ${IMMICH_DB_LOCATION:?missing IMMICH_DB_LOCATION}:/var/lib/postgresql/data
    shm_size: 128mb
    networks:
      - immich

  # ===========================================================================
  # issue 007 — Paperless-ngx: document ingest, OCR, full-text search. Five
  # services (webserver + redis + postgres + gotenberg + tika), mirroring the
  # OFFICIAL paperless-ngx postgres-tika compose with these helium divergences
  # (same discipline as the Immich block above):
  #   - NO published ports. Upstream publishes 8000:8000; here the webserver is
  #     reached only through Traefik at paperless.${DOMAIN}. Under
  #     compose_restrict_to_mesh=false a published port would be LAN-reachable.
  #   - Services namespaced paperless-* (upstream: webserver/db/broker/gotenberg/
  #     tika) so the generic names stay free; PAPERLESS_DBHOST/REDIS point at them.
  #   - Postgres 17 with the CLASSIC /var/lib/postgresql/data mount (upstream main
  #     moved to pg18 + /var/lib/postgresql, a version-specific PGDATA footgun). The
  #     image self-chowns PGDATA on init, so pgdata is left root-owned (Ansible only
  #     ensures it exists) — exactly the issue-006 postgres pattern.
  #   - env_file DROPPED (it would inject every stack's secrets); the webserver gets
  #     an explicit environment: block with only its own vars.
  #   - Backends (redis/postgres/gotenberg/tika) sit on the dedicated internal
  #     `paperless` bridge; the webserver is dual-homed on `media` so Traefik reaches
  #     it. No backend joins the shared media bridge.
  #   - Data/media/consume/export bind onto paperless's in-container defaults under
  #     the SSD 'paperless' precious subvol (docs: do NOT override the *_DIR env vars
  #     under docker — mount onto the defaults). The webserver runs as USERMAP_UID:GID
  #     (the jellyfin uid/gid) and owns them.
  #   - OCR on CPU: eng is bundled; swe is installed at startup (PAPERLESS_OCR_LANGUAGES).
  # Post-deploy human steps (needs-human): create the admin (populate the optional
  # PAPERLESS_ADMIN_* vars in sops, OR `docker exec -it paperless document_create_superuser`);
  # then drop a PDF into the consume folder and confirm OCR -> full-text searchable.
  # ===========================================================================

  paperless:
    image: ghcr.io/paperless-ngx/paperless-ngx:${PAPERLESS_VERSION:?missing PAPERLESS_VERSION}
    container_name: paperless
    restart: unless-stopped
    # issue 010: entrypoint starts root, installs the swe tesseract pkg (dpkg -> needs CHOWN /
    # DAC_OVERRIDE / FOWNER) and gosu-drops to USERMAP_UID 1001 (needs SETGID / SETUID) -> curated
    # caps (see anchor). Runtime uid unchanged (already USERMAP 1001) -> no chown.
    cap_drop:
      - ALL
    cap_add: *caps-privdrop
    security_opt:
      - "no-new-privileges:true"
    depends_on:
      paperless-db:
        condition: service_healthy
      paperless-redis:
        condition: service_healthy
      paperless-gotenberg:
        condition: service_started
      paperless-tika:
        condition: service_started
    labels:
      - "traefik.enable=true"
      # issue 009 — paperless is dual-homed (media + paperless); pin Traefik to the media
      # bridge, same rationale as immich-server above. This one currently routes fine, but
      # that's just the network-name ordering the provider happens to pick — the label makes
      # it deterministic so a future recreate can't flip it to the unroutable paperless-net IP.
      - "traefik.docker.network={{ compose_stack_dir | basename }}_media"
      - "traefik.http.routers.paperless.rule=Host(`paperless.${DOMAIN:?missing DOMAIN}`)"
      - "traefik.http.routers.paperless.entrypoints=websecure"
      - "traefik.http.routers.paperless.tls.certresolver=letsencrypt"
      - "traefik.http.services.paperless.loadbalancer.server.port=8000"
      - "traefik.http.routers.paperless.middlewares=security-headers@file"
    environment:
      - PAPERLESS_REDIS=redis://paperless-redis:6379
      - PAPERLESS_DBHOST=paperless-db
      - PAPERLESS_DBUSER=${PAPERLESS_DB_USERNAME:-paperless}
      - PAPERLESS_DBNAME=${PAPERLESS_DB_NAME:-paperless}
      - PAPERLESS_DBPASS=${PAPERLESS_DB_PASSWORD:?missing PAPERLESS_DB_PASSWORD}
      - PAPERLESS_SECRET_KEY=${PAPERLESS_SECRET_KEY:?missing PAPERLESS_SECRET_KEY}
      # External URL -> sets ALLOWED_HOSTS + CSRF_TRUSTED_ORIGINS for the reverse proxy.
      - PAPERLESS_URL=https://paperless.${DOMAIN:?missing DOMAIN}
      # Office-doc + email parsing via Gotenberg + Tika.
      - PAPERLESS_TIKA_ENABLED=1
      - PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://paperless-gotenberg:3000
      - PAPERLESS_TIKA_ENDPOINT=http://paperless-tika:9998
      # OCR: active language(s), and extra tesseract pkgs installed at startup.
      - PAPERLESS_OCR_LANGUAGE=${PAPERLESS_OCR_LANGUAGE:-eng}
      - PAPERLESS_OCR_LANGUAGES=${PAPERLESS_OCR_INSTALL_LANGS:-}
      # The container runs as this uid/gid and chowns its data dirs to it.
      - USERMAP_UID=${PAPERLESS_USERMAP_UID:-1001}
      - USERMAP_GID=${PAPERLESS_USERMAP_GID:-1003}
      - PAPERLESS_TIME_ZONE=${TZ:-Europe/Stockholm}
      # Admin auto-create (optional): empty -> create the superuser manually post-deploy.
      - PAPERLESS_ADMIN_USER=${PAPERLESS_ADMIN_USER:-}
      - PAPERLESS_ADMIN_PASSWORD=${PAPERLESS_ADMIN_PASSWORD:-}
    volumes:
      # Bind the SSD subdirs onto paperless's in-container default paths.
      - ${PAPERLESS_DATA_ROOT:?missing PAPERLESS_DATA_ROOT}/data:/usr/src/paperless/data
      - ${PAPERLESS_DATA_ROOT:?missing PAPERLESS_DATA_ROOT}/media:/usr/src/paperless/media
      - ${PAPERLESS_DATA_ROOT:?missing PAPERLESS_DATA_ROOT}/export:/usr/src/paperless/export
      - ${PAPERLESS_DATA_ROOT:?missing PAPERLESS_DATA_ROOT}/consume:/usr/src/paperless/consume
    networks:
      - media       # Traefik reaches the webserver here
      - paperless   # redis / postgres / gotenberg / tika backends
    # No healthcheck: with PAPERLESS_URL set, ALLOWED_HOSTS rejects a localhost-Host
    # probe (400), so a naive healthcheck would report unhealthy though the app is up
    # (same reasoning as the homepage service). restart + Traefik suffice.

  paperless-redis:
    image: docker.io/library/redis:8.8.0
    container_name: paperless_redis
    restart: unless-stopped
    # issue 010: the official redis image drops root via `setpriv` (NOT gosu like postgres/valkey).
    # setpriv clears the capability BOUNDING set (PR_CAPBSET_DROP), which needs CAP_SETPCAP on top
    # of the curated privdrop caps — without it: "setpriv: apply bounding set: Operation not
    # permitted" -> crash-loop. So this one image gets the anchor set + SETPCAP (explicit, not the
    # shared anchor, so the gosu-based images aren't needlessly widened).
    cap_drop:
      - ALL
    cap_add: [CHOWN, DAC_OVERRIDE, FOWNER, SETGID, SETUID, SETPCAP]
    security_opt:
      - "no-new-privileges:true"
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping || exit 1"]
    volumes:
      - paperless_redis:/data
    networks:
      - paperless

  paperless-db:
    image: docker.io/library/postgres:17.10
    container_name: paperless_postgres
    restart: unless-stopped
    # issue 010: official postgres entrypoint starts root, self-chowns PGDATA, gosu-drops to uid
    # 999 -> curated caps (see anchor). No user: override (per the frozen brief); PGDATA stays
    # 999-owned, no chown.
    cap_drop:
      - ALL
    cap_add: *caps-privdrop
    security_opt:
      - "no-new-privileges:true"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${PAPERLESS_DB_USERNAME:-paperless} || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 30s
    environment:
      - POSTGRES_DB=${PAPERLESS_DB_NAME:-paperless}
      - POSTGRES_USER=${PAPERLESS_DB_USERNAME:-paperless}
      - POSTGRES_PASSWORD=${PAPERLESS_DB_PASSWORD:?missing PAPERLESS_DB_PASSWORD}
      - POSTGRES_INITDB_ARGS=--data-checksums
    volumes:
      # Postgres data on the SSD 'paperless' precious subvol. Classic PGDATA mount;
      # the image self-chowns it on first init (dir left root-owned by Ansible).
      - ${PAPERLESS_DATA_ROOT:?missing PAPERLESS_DATA_ROOT}/pgdata:/var/lib/postgresql/data
    networks:
      - paperless

  paperless-gotenberg:
    image: docker.io/gotenberg/gotenberg:8.34
    container_name: paperless_gotenberg
    restart: unless-stopped
    # issue 010: curated caps as the safe superset (drop mechanism unverified — box was
    # unreachable). Runs headless Chromium with --chromium-* flags (sandbox off), so the dropped
    # caps + no-new-privileges don't touch a sandbox it isn't using.
    cap_drop:
      - ALL
    cap_add: *caps-privdrop
    security_opt:
      - "no-new-privileges:true"
    # Paperless's required gotenberg flags (upstream compose): disable JS, restrict
    # file access to /tmp (where paperless drops files to convert).
    command:
      - "gotenberg"
      - "--chromium-disable-javascript=true"
      - "--chromium-allow-list=file:///tmp/.*"
    networks:
      - paperless

  paperless-tika:
    image: docker.io/apache/tika:3.3.1.0
    container_name: paperless_tika
    restart: unless-stopped
    # issue 010: curated caps as the safe superset (drop mechanism unverified). Java on 9998
    # (>1024, no NET_BIND_SERVICE).
    cap_drop:
      - ALL
    cap_add: *caps-privdrop
    security_opt:
      - "no-new-privileges:true"
    networks:
      - paperless

  # ===========================================================================
  # issue 029 — Proton Mail Bridge: gives Paperless an IMAP mailbox to ingest from.
  # Proton exposes NO native IMAP/SMTP; Bridge logs into Proton, decrypts mail locally,
  # and re-serves it as plaintext IMAP/SMTP on container-localhost. socat (in the image)
  # forwards container :25/:143 -> the bridge's 127.0.0.1:1025/1143 (the bridge only
  # accepts loopback). Reached ONLY by the paperless webserver at protonmail-bridge:143
  # over the shared internal `paperless` bridge — no ports:, no Traefik, off `media`.
  #
  # Encryption paperless->bridge = None (Paperless mail-account security: None). Safe:
  # the plaintext hop is container-to-container on a private docker bridge, and the E2E
  # encryption to Proton is a separate layer that stays intact. STARTTLS/SSL against the
  # bridge's self-signed cert is the path upstream guides gave up on.
  #
  # Image: LOCALLY BUILT from ./build/protonmail-bridge/Dockerfile (FROM shenxn's
  # `deb` image + libfido2). The stock shenxn image ships bridge v3.19.0 but the bridge
  # auto-updates itself at runtime to a version that needs libfido2, which the dep-stripped
  # repack omits -> the updated binary won't launch. The Dockerfile adds it back (issue 029).
  # It generates a PASSPHRASELESS gpg/pass keyring in /root at `init` (gpgparams %no-protection),
  # so there is NO keyring secret to inject — the session + keyring persist in the bind
  # volume alone. Loss of that volume = re-login + 2FA (see the issue runbook).
  #
  # Post-deploy human steps (needs-human — 2FA can't be Ansible-automated):
  #   docker stop protonmail-bridge
  #   docker compose -f {{ compose_stack_dir }}/docker-compose.yml --env-file {{ compose_stack_dir }}/.env \
  #     run --rm protonmail-bridge init   # -> `login` (Proton creds + TOTP), `info` (IMAP
  #                                       #    user + generated pass), `exit`; Ctrl-C to detach
  #   docker start protonmail-bridge
  #   then in Paperless: add a Mail Account (host protonmail-bridge, port 143, security None,
  #   user = Proton address, pass = the `info` password) + a Mail Rule (consume attachments).
  # ===========================================================================

  protonmail-bridge:
    build:
      context: ./build/protonmail-bridge   # -> {{ compose_stack_dir }}/build/protonmail-bridge (Ansible-copied)
    image: helium/protonmail-bridge:3.19.0-1-fido2   # locally-built patched image (see build task)
    container_name: protonmail-bridge
    restart: unless-stopped
    # issue 010: runs as root by design (init generates a gpg/pass keyring, then runs socat +
    # the bridge). socat binds container ports 25 + 143, both <1024 -> needs CAP_NET_BIND_SERVICE
    # even as uid 0 (an empty cap set can't bind privileged ports — same as traefik above). No
    # privilege drop and no other cap is needed; drop everything else.
    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - "no-new-privileges:true"
    volumes:
      # Bridge session + gpg/pass keyring live under /root. Precious (loss = re-login + 2FA):
      # the SSD 'appdata' precious subvol. Bound (not a named volume) so the one-shot `init`
      # login container and this long-running service share the exact same session state.
      - ${PROTONMAIL_BRIDGE_DATA:?missing PROTONMAIL_BRIDGE_DATA}:/root
    networks:
      - paperless   # only the paperless webserver reaches it (protonmail-bridge:143)
