#!/usr/bin/env node
// ha — small CLI for poking the Home Assistant on home.stromdahl.tech.
//
// Read:
//   ha state <entity_id>                         # slimmed: no last_*/context fields
//   ha entities [pattern]                        # glob (e.g. 'sensor.*temp*') or /regex/
//   ha services [domain[.service]]               # introspect /api/services
//   ha template '<jinja>'
//
// Write:
//   ha call <domain.service> '<json-data>'
//
// Config-flow integrations & helpers:
//   ha flow <handler> '<json>' ['<json>' ...]    # drive a config_entries flow; one JSON per step. Used for
//                                                #   config-flow helpers (history_stats, utility_meter,
//                                                #   derivative, threshold, ...) and integration setup.
//                                                #   Prints the final create_entry response. Aborts on form error.
//   ha entry list [domain]                       # list config entries; optional domain filter
//   ha entry get <entry_id>
//   ha entry delete <entry_id>
//   ha entry reload <entry_id>
//   ha entry flows                               # in-progress flows awaiting input
//
// Dashboards:
//   ha dash list
//   ha dash get <url_path> [file]                # default: stdout
//   ha dash save <url_path> <file>               # push file -> HA
//
// Automations:
//   ha auto list
//   ha auto get <id> [file]
//   ha auto save <id> <file>
//   ha auto delete <id>
//
// Scenes:
//   ha scene list
//   ha scene get <id> [file]
//   ha scene save <id> <file>                    # POST + scene.reload
//   ha scene delete <id>
//
// Collection helpers (input_*) — WS-based:
//   ha helper list
//   ha helper create <type> '<json>'             # type: input_number / input_button / ...
//   ha helper delete <type> <id>
//
// Registry — entities, devices, areas:
//   ha entity list                               # entity_id, name, area_id, device_id, disabled_by, hidden_by
//   ha entity get <entity_id>
//   ha entity update <entity_id> '<json>'        # e.g. {"name":"...","area_id":"...","new_entity_id":"..."}
//   ha entity remove <entity_id>
//   ha entity disable <entity_id>                # shortcut: update disabled_by=user
//   ha entity enable <entity_id>                 # shortcut: update disabled_by=null
//   ha device list                               # device_id, area_id, name_by_user, model
//   ha device update <device_id> '<json>'        # e.g. {"area_id":"kitchen","name_by_user":"Fridge"}
//   ha area list
//   ha area create '<json>'                      # {"name":"Fridge","icon":"mdi:fridge"}
//   ha area delete <area_id>
//
// Raw:
//   ha ws '<json>'                               # raw WS command, prints the result payload
//
// Global flags (any position):
//   --pretty                                     # pretty-print JSON output (default: compact, single-line)
//   --quiet | -q                                 # silence "saved"/"deleted" chatter on writes
//   -o <key.path> | --output <key.path>          # extract a field from JSON output; print scalar if leaf is primitive
//
// Auth: reads the bearer token from ~/.ha-token.json (the MCP-shaped file).
// Host: home.stromdahl.tech (HTTPS for REST, WSS for WebSocket).
//       Override with $HA_BASE — e.g. HA_BASE=http://192.168.1.99:8123 for LAN/sandbox
//       use. http:// implies ws://; https:// implies wss://.

const fs = require('fs');
const path = require('path');

const TOKEN_FILE = path.join(process.env.HOME, '.ha-token.json');
const BASE = (process.env.HA_BASE || 'https://home.stromdahl.tech').replace(/\/+$/, '');
const WS_BASE = BASE.replace(/^http/, 'ws');

const FLAGS = { pretty: false, quiet: false, output: null };

// Returns the number of *additional* args consumed (0 or 1) when `a` is a flag,
// or -1 when `a` is positional.
function applyFlag(a, next) {
  if (a === '--pretty')               { FLAGS.pretty = true; return 0; }
  if (a === '--quiet' || a === '-q')  { FLAGS.quiet  = true; return 0; }
  if (a === '-o' || a === '--output') { FLAGS.output = next; return 1; }
  const eq = /^(?:--output|-o)=(.*)$/.exec(a);
  if (eq)                              { FLAGS.output = eq[1]; return 0; }
  return -1;
}

function parseArgs(argv) {
  const positional = [];
  for (let i = 0; i < argv.length; i++) {
    const adv = applyFlag(argv[i], argv[i + 1]);
    if (adv < 0) positional.push(argv[i]);
    else i += adv;
  }
  return positional;
}

let TOKEN_CACHE;
function token() {
  if (TOKEN_CACHE) return TOKEN_CACHE;
  const j = JSON.parse(fs.readFileSync(TOKEN_FILE, 'utf8'));
  TOKEN_CACHE = j.headers.Authorization.replace(/^Bearer\s+/, '');
  return TOKEN_CACHE;
}

async function rest(method, endpoint, body) {
  const res = await fetch(`${BASE}/api${endpoint}`, {
    method,
    headers: {
      Authorization: 'Bearer ' + token(),
      'Content-Type': 'application/json',
    },
    body: body !== undefined ? JSON.stringify(body) : undefined,
  });
  const text = await res.text();
  if (!res.ok) {
    throw new Error(`HTTP ${res.status}: ${text}`);
  }
  if (!text) return null;
  try { return JSON.parse(text); } catch { return text; }
}

function wsClient() {
  const ws = new WebSocket(`${WS_BASE}/api/websocket`);
  let nextId = 1;
  const pending = new Map();
  let closed = false;
  const fail = (err) => {
    closed = true;
    for (const [, p] of pending) p.rej(err);
    pending.clear();
  };
  const ready = new Promise((res, rej) => {
    ws.onmessage = (ev) => {
      const m = JSON.parse(ev.data);
      if (m.type === 'auth_required') return ws.send(JSON.stringify({ type: 'auth', access_token: token() }));
      if (m.type === 'auth_ok') return res();
      if (m.type === 'auth_invalid') { closed = true; return rej(new Error('auth_invalid')); }
      if (m.type === 'result') {
        const p = pending.get(m.id); if (!p) return;
        pending.delete(m.id);
        if (m.success) p.res(m.result); else p.rej(new Error(JSON.stringify(m.error)));
      }
    };
    ws.onerror = (e) => { rej(new Error('WS ' + (e.message || e))); fail(new Error('WS error')); };
    ws.onclose = () => fail(new Error('WS closed before result'));
  });
  return {
    async send(msg) {
      await ready;
      if (closed) throw new Error('WS closed');
      return new Promise((res, rej) => {
        const id = nextId++;
        pending.set(id, { res, rej });
        ws.send(JSON.stringify({ ...msg, id }));
      });
    },
    close: () => ws.close(),
  };
}

async function withWs(fn) {
  const c = wsClient();
  try { return await fn(c); } finally { c.close(); }
}

// Strip noise top-level fields from /api/states/<eid> payloads.
const STATE_NOISE = new Set(['last_changed', 'last_reported', 'last_updated', 'context']);
function slim(s) {
  if (!s || typeof s !== 'object' || Array.isArray(s)) return s;
  const out = {};
  for (const k of Object.keys(s)) if (!STATE_NOISE.has(k)) out[k] = s[k];
  return out;
}

function pluck(obj, p) {
  return p.split('.').reduce((o, k) => (o == null ? undefined : o[k]), obj);
}

function isPrimitive(v) {
  return typeof v === 'string' || typeof v === 'number' || typeof v === 'boolean';
}

function formatValue(v) {
  if (isPrimitive(v)) return String(v);
  return FLAGS.pretty ? JSON.stringify(v, null, 2) : JSON.stringify(v);
}

function printJSON(x) {
  if (typeof x === 'string') return console.log(x);
  const v = FLAGS.output ? pluck(x, FLAGS.output) : x;
  if (v == null) return;
  console.log(formatValue(v));
}

const writeOrLog = (file, data) => file ? fs.writeFileSync(file, JSON.stringify(data, null, 2) + '\n') : printJSON(data);
const readJSON = (file) => JSON.parse(fs.readFileSync(file, 'utf8'));
const say = (m) => { if (!FLAGS.quiet) console.log(m); };

// Glob (* ?) → RegExp. /…/ form is treated as raw regex.
function patternToRegex(pat) {
  if (pat.length >= 2 && pat.startsWith('/') && pat.endsWith('/')) return new RegExp(pat.slice(1, -1));
  const esc = pat.replace(/[.+^${}()|[\]\\]/g, '\\$&').replace(/\*/g, '.*').replace(/\?/g, '.');
  return new RegExp('^' + esc + '$');
}

// ---------- subcommands ----------

const cmds = {
  async state([eid]) {
    if (!eid) throw new Error('usage: ha state <entity_id>');
    printJSON(slim(await rest('GET', `/states/${eid}`)));
  },
  async call([service, dataJson]) {
    if (!service) throw new Error('usage: ha call <domain.service> [json]');
    const [domain, svc] = service.split('.', 2);
    const body = dataJson ? JSON.parse(dataJson) : {};
    printJSON(await rest('POST', `/services/${domain}/${svc}`, body));
  },
  async template([tpl]) {
    if (!tpl) throw new Error('usage: ha template <jinja>');
    printJSON(await rest('POST', '/template', { template: tpl }));
  },
  async ws([json]) {
    if (!json) throw new Error('usage: ha ws <json-message>');
    const msg = JSON.parse(json);
    await withWs(async (c) => printJSON(await c.send(msg)));
  },
  async flow([handler, ...stepArgs]) {
    if (!handler || stepArgs.length === 0) {
      throw new Error("usage: ha flow <handler> '<step1-json>' ['<step2-json>' ...]");
    }
    const steps = stepArgs.map((s, i) => {
      try { return JSON.parse(s); } catch (e) { throw new Error(`step ${i + 1} is not valid JSON: ${e.message}`); }
    });
    let resp = await rest('POST', '/config/config_entries/flow', { handler, show_advanced_options: false });
    for (let i = 0; i < steps.length; i++) {
      if (resp.type !== 'form') break;
      resp = await rest('POST', `/config/config_entries/flow/${resp.flow_id}`, steps[i]);
      if (resp.errors) throw new Error(`step ${i + 1} errors: ${JSON.stringify(resp.errors)}`);
    }
    if (resp.type === 'form') {
      throw new Error(`flow not finished — next step '${resp.step_id}' still needed. Schema:\n${JSON.stringify(resp.data_schema, null, 2)}`);
    }
    printJSON(resp);
  },
  async entities([pattern]) {
    const states = await rest('GET', '/states');
    const re = pattern ? patternToRegex(pattern) : null;
    const rows = states
      .filter((s) => !re || re.test(s.entity_id))
      .map((s) => `${s.entity_id}\t${s.state}\t${s.attributes.friendly_name ?? '-'}\t${s.attributes.device_class ?? '-'}`)
      .sort();
    say('entity_id\tstate\tfriendly_name\tdevice_class');
    rows.forEach((r) => console.log(r));
  },
  async services([filter]) {
    const list = await rest('GET', '/services');
    if (!filter) {
      const out = [];
      for (const d of list) for (const s of Object.keys(d.services)) out.push(`${d.domain}.${s}`);
      out.sort();
      out.forEach((s) => console.log(s));
      return;
    }
    const [domain, svc] = filter.split('.', 2);
    const d = list.find((x) => x.domain === domain);
    if (!d) { console.error(`unknown domain: ${domain}`); process.exit(1); }
    if (!svc) { printJSON(d.services); return; }
    if (!(svc in d.services)) { console.error(`unknown service: ${filter}`); process.exit(1); }
    printJSON(d.services[svc]);
  },

  dash: {
    async list() {
      await withWs(async (c) => {
        const list = await c.send({ type: 'lovelace/dashboards/list' });
        list.forEach((d) => console.log(`${d.url_path}\t${d.title}\t${d.icon ?? ''}`));
      });
    },
    async get([urlPath, file]) {
      if (!urlPath) throw new Error('usage: ha dash get <url_path> [file]');
      await withWs(async (c) => {
        const cfg = await c.send({ type: 'lovelace/config', url_path: urlPath });
        writeOrLog(file, cfg);
      });
    },
    async save([urlPath, file]) {
      if (!urlPath || !file) throw new Error('usage: ha dash save <url_path> <file>');
      const cfg = readJSON(file);
      await withWs(async (c) => {
        await c.send({ type: 'lovelace/config/save', url_path: urlPath, config: cfg });
        say('saved');
      });
    },
  },

  auto: {
    async list() {
      const states = await rest('GET', '/states');
      states
        .filter((s) => s.entity_id.startsWith('automation.'))
        .sort((a, b) => a.entity_id.localeCompare(b.entity_id))
        .forEach((s) => console.log(`${s.attributes.id ?? s.entity_id.replace('automation.', '')}\t${s.attributes.friendly_name ?? '-'}\t[${s.state}]`));
    },
    async get([id, file]) {
      if (!id) throw new Error('usage: ha auto get <id> [file]');
      writeOrLog(file, await rest('GET', `/config/automation/config/${id}`));
    },
    async save([id, file]) {
      if (!id || !file) throw new Error('usage: ha auto save <id> <file>');
      const cfg = readJSON(file);
      await rest('POST', `/config/automation/config/${id}`, cfg);
      await rest('POST', '/services/automation/reload');
      say('saved + reloaded');
    },
    async delete([id]) {
      if (!id) throw new Error('usage: ha auto delete <id>');
      await rest('DELETE', `/config/automation/config/${id}`);
      say('deleted');
    },
  },

  scene: {
    async list() {
      const states = await rest('GET', '/states');
      states
        .filter((s) => s.entity_id.startsWith('scene.'))
        .sort((a, b) => a.entity_id.localeCompare(b.entity_id))
        .forEach((s) => console.log(`${s.attributes.id ?? s.entity_id.replace('scene.', '')}\t${s.attributes.friendly_name ?? '-'}`));
    },
    async get([id, file]) {
      if (!id) throw new Error('usage: ha scene get <id> [file]');
      writeOrLog(file, await rest('GET', `/config/scene/config/${id}`));
    },
    async save([id, file]) {
      if (!id || !file) throw new Error('usage: ha scene save <id> <file>');
      const cfg = readJSON(file);
      await rest('POST', `/config/scene/config/${id}`, cfg);
      await rest('POST', '/services/scene/reload');
      say('saved + reloaded');
    },
    async delete([id]) {
      if (!id) throw new Error('usage: ha scene delete <id>');
      await rest('DELETE', `/config/scene/config/${id}`);
      say('deleted');
    },
  },

  entity: {
    async list() {
      await withWs(async (c) => {
        const list = await c.send({ type: 'config/entity_registry/list' });
        list
          .sort((a, b) => a.entity_id.localeCompare(b.entity_id))
          .forEach((e) => console.log([
            e.entity_id,
            e.name ?? e.original_name ?? '-',
            e.area_id ?? '-',
            e.device_id ?? '-',
            e.disabled_by ?? '',
            e.hidden_by ?? '',
          ].join('\t')));
      });
    },
    async get([eid]) {
      if (!eid) throw new Error('usage: ha entity get <entity_id>');
      await withWs(async (c) => printJSON(await c.send({ type: 'config/entity_registry/get', entity_id: eid })));
    },
    async update([eid, json]) {
      if (!eid || !json) throw new Error('usage: ha entity update <entity_id> <json>  (e.g. {"name":"...","area_id":"...","new_entity_id":"..."})');
      const payload = JSON.parse(json);
      await withWs(async (c) => printJSON(await c.send({ type: 'config/entity_registry/update', entity_id: eid, ...payload })));
    },
    async remove([eid]) {
      if (!eid) throw new Error('usage: ha entity remove <entity_id>');
      await withWs(async (c) => printJSON(await c.send({ type: 'config/entity_registry/remove', entity_id: eid })));
    },
    async disable([eid]) {
      if (!eid) throw new Error('usage: ha entity disable <entity_id>');
      await withWs(async (c) => printJSON(await c.send({ type: 'config/entity_registry/update', entity_id: eid, disabled_by: 'user' })));
    },
    async enable([eid]) {
      if (!eid) throw new Error('usage: ha entity enable <entity_id>');
      await withWs(async (c) => printJSON(await c.send({ type: 'config/entity_registry/update', entity_id: eid, disabled_by: null })));
    },
  },

  device: {
    async list() {
      await withWs(async (c) => {
        const list = await c.send({ type: 'config/device_registry/list' });
        list
          .sort((a, b) => (a.area_id ?? '').localeCompare(b.area_id ?? '') || a.id.localeCompare(b.id))
          .forEach((d) => console.log(`${d.id}\t${d.area_id ?? '-'}\t${d.name_by_user ?? d.name ?? '-'}\t${d.model ?? '-'}`));
      });
    },
    async update([deviceId, json]) {
      if (!deviceId || !json) throw new Error('usage: ha device update <device_id> <json>');
      const payload = JSON.parse(json);
      await withWs(async (c) => printJSON(await c.send({ type: 'config/device_registry/update', device_id: deviceId, ...payload })));
    },
  },

  area: {
    async list() {
      await withWs(async (c) => {
        const list = await c.send({ type: 'config/area_registry/list' });
        list
          .sort((a, b) => (a.area_id ?? '').localeCompare(b.area_id ?? ''))
          .forEach((a) => console.log(`${a.area_id}\t${a.name}\t${a.icon ?? '-'}`));
      });
    },
    async create([json]) {
      if (!json) throw new Error('usage: ha area create <json>  (e.g. {"name":"Fridge","icon":"mdi:fridge"})');
      const payload = JSON.parse(json);
      await withWs(async (c) => printJSON(await c.send({ type: 'config/area_registry/create', ...payload })));
    },
    async delete([areaId]) {
      if (!areaId) throw new Error('usage: ha area delete <area_id>');
      await withWs(async (c) => printJSON(await c.send({ type: 'config/area_registry/delete', area_id: areaId })));
    },
  },

  entry: {
    async list([domainFilter]) {
      let list = await rest('GET', '/config/config_entries/entry');
      if (domainFilter) list = list.filter((e) => e.domain === domainFilter);
      list.sort((a, b) => (a.domain ?? '').localeCompare(b.domain ?? '') || (a.title ?? '').localeCompare(b.title ?? ''));
      list.forEach((e) => console.log(`${e.entry_id}\t${e.domain}\t${e.title ?? '-'}\t${e.state}\t${e.source ?? '-'}`));
    },
    async get([entryId]) {
      if (!entryId) throw new Error('usage: ha entry get <entry_id>');
      const list = await rest('GET', '/config/config_entries/entry');
      const e = list.find((x) => x.entry_id === entryId);
      if (!e) { console.error(`unknown entry: ${entryId}`); process.exit(1); }
      printJSON(e);
    },
    async delete([entryId]) {
      if (!entryId) throw new Error('usage: ha entry delete <entry_id>');
      printJSON(await rest('DELETE', `/config/config_entries/entry/${entryId}`));
    },
    async reload([entryId]) {
      if (!entryId) throw new Error('usage: ha entry reload <entry_id>');
      printJSON(await rest('POST', `/config/config_entries/entry/${entryId}/reload`));
    },
    async flows() {
      await withWs(async (c) => printJSON(await c.send({ type: 'config_entries/flow/progress' })));
    },
  },

  helper: {
    async list() {
      const states = await rest('GET', '/states');
      states
        .filter((s) =>
          s.entity_id.startsWith('input_number.') ||
          s.entity_id.startsWith('input_boolean.') ||
          s.entity_id.startsWith('input_button.') ||
          s.entity_id.startsWith('input_text.') ||
          s.entity_id.startsWith('input_select.') ||
          s.entity_id.startsWith('input_datetime.'))
        .sort((a, b) => a.entity_id.localeCompare(b.entity_id))
        .forEach((s) => console.log(`${s.entity_id}\t${s.state}\t${s.attributes.friendly_name ?? '-'}`));
    },
    async create([type, json]) {
      if (!type || !json) throw new Error('usage: ha helper create <type> <json>  (type: input_number, input_button, ...)');
      const payload = JSON.parse(json);
      await withWs(async (c) => printJSON(await c.send({ type: `${type}/create`, ...payload })));
    },
    async delete([type, id]) {
      if (!type || !id) throw new Error('usage: ha helper delete <type> <id>');
      await withWs(async (c) => printJSON(await c.send({ type: `${type}/delete`, [`${type}_id`]: id })));
    },
  },
};

// ---------- dispatcher ----------

function isCmdNode(x) {
  return x != null && typeof x === 'object' && !Array.isArray(x);
}

// Walk the cmds tree. Returns either { fn, rest } when a leaf function is reached,
// or { node, i } pointing at where the walk stopped.
function walkCmd(argv) {
  let node = cmds;
  let i = 0;
  while (i < argv.length && isCmdNode(node)) {
    const next = node[argv[i]];
    if (typeof next === 'function') return { fn: next, rest: argv.slice(i + 1) };
    if (!isCmdNode(next)) return { node, i };
    node = next; i++;
  }
  return { node, i };
}

function reportUnknown(argv, node, i) {
  if (i > 0 && isCmdNode(node)) {
    const prefix = `ha ${argv.slice(0, i).join(' ')}`;
    const avail = Object.keys(node).join(', ');
    const msg = i < argv.length
      ? `${prefix}: unknown sub-verb '${argv[i]}'. Available: ${avail}`
      : `${prefix}: subcommand required. Available: ${avail}`;
    console.error(msg);
  } else {
    console.error(`unknown command: ${argv.join(' ')}`);
  }
  process.exit(2);
}

(async () => {
  const argv = parseArgs(process.argv.slice(2));
  if (argv.length === 0) {
    console.log("ha — Home Assistant CLI. See top of script for usage.");
    process.exit(0);
  }
  const { fn, rest, node, i } = walkCmd(argv);
  if (fn) { await fn(rest); return; }
  reportUnknown(argv, node, i);
})().catch((e) => { console.error(e.message || e); process.exit(1); });
