// Local overrides for unattended-upgrades. Managed by Ansible (roles/base).
// Defaults live in /etc/apt/apt.conf.d/50unattended-upgrades; on Debian
// those already restrict origins to *-security, which is what we want.

Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";

// Never reboot without the operator asking.
Unattended-Upgrade::Automatic-Reboot "false";
