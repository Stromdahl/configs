[user]
	email = mattias.stromdahl@gmail.com
	name = Mattias Strömdahl
[pull]
	rebase = false
[init]
	defaultBranch = main
[alias]
	gud = !echo \"OK\"
	wt = worktree
	wtl = worktree list
	wtp = !git worktree prune --expire=now
	wts = "!git worktree list | while read -r path _ branch; do echo \"=== $branch ($path)\"; git -C \"$path\" status --short; done"
	wta  = "!f(){ git fetch -p && git worktree add \"${2:-../$1}\" -b \"$1\"; }; f"
	wtat = "!f(){ git fetch -p && git worktree add --guess-remote \"${2:-../$1}\" \"$1\"; }; f"
	wtr  = "!f(){ git worktree remove \"$1\"; }; f"
[core]
	sshCommand = "ssh -i ~/.ssh/id_ed25519"
